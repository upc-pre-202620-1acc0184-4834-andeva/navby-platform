# Navby Platform — variables de entorno
# Copiar a .env (nunca se versiona). Con estos valores el backend funciona en local
# sin ningún secreto real: FlightAPI usa el mock y el correo se escribe en el log.
# Detalle por entorno: docs/backend-documentation/navby-platform-documentation.md#variables-de-entorno

# --- Entorno ---
APP_ENV=local                       # local | production

# --- Persistencia (contenedores de docker-compose.dev.yml) ---
DATABASE_URL=postgresql+asyncpg://navby:navby@localhost:5432/navby
REDIS_URL=redis://localhost:6379/0

# --- Seguridad ---
JWT_SECRET=change-me-local-only-32-bytes-minimum
COOKIE_SECURE=false                 # true en producción
TRUST_PROXY_HEADERS=false           # true en producción (proxy de Vercel)
TERMS_VERSION=2026-10

# --- URLs ---
WEBAPP_URL=http://localhost:5173/app
API_PUBLIC_URL=                     # en local, URL de un túnel (ngrok) solo si pruebas el webhook de Mercado Pago

# --- Google OAuth (cliente propio de desarrollo, origen http://localhost:5173) ---
GOOGLE_CLIENT_ID=

# --- FlightAPI (vacío = MockFlightOffersProvider) ---
FLIGHT_API_KEY=
FLIGHT_API_MAX_CONCURRENCY=5

# --- Mercado Pago (credenciales TEST- de tu cuenta sandbox) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Resend (vacío = el correo se escribe en el log) ---
RESEND_API_KEY=
